# Public HTTPS URL of the platform (Telegram webhook + handoff callbacks)
PUBLIC_BASE_URL=https://example.com

# "production" enables startup safety checks (https, strong secret, webhook secret)
ENVIRONMENT=development

# PostgreSQL in production; SQLite is fine locally.
DATABASE_URL=sqlite:///./data/paybot.db
# DATABASE_URL=postgresql+psycopg://paybot:paybot@db:5432/paybot

# Random long string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-change-me-change-me-change-me

# Telegram BotFather token and the secret_token passed to setWebhook.
# Production refuses to start when a bot token is set but this secret is empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Register the webhook and command list automatically at startup.
TELEGRAM_AUTO_SETUP=0
# Only use true for the very first deployment; it discards queued updates.
TELEGRAM_DROP_PENDING_UPDATES=0

# Bootstrap platform-admin token. Used by the admin API and the /admin UI.
ADMIN_API_TOKEN=
# Chat/user id that receives operational alerts (amount mismatch, outbox dead...)
ADMIN_CHAT_ID=

# Platform-level legal and support pages
SUPPORT_EMAIL=support@example.com
SUPPORT_URL=
TERMS_URL=https://example.com/legal/terms
PRIVACY_URL=https://example.com/legal/privacy

# Checkout and tokens
ORDER_TTL_MINUTES=30
ORDER_DEDUPE_SECONDS=30
ALLOW_LATE_PAYMENT=1
LATE_PAYMENT_MAX_MINUTES=1440
HANDOFF_TTL_SECONDS=60
INIT_DATA_TTL_SECONDS=300

# Background worker (outbox, expiry, webhook health)
WORKERS_ENABLED=1
AUTO_CREATE_TABLES=1
OUTBOX_INTERVAL_SECONDS=5
OUTBOX_MAX_ATTEMPTS=8
ORDER_EXPIRY_INTERVAL_SECONDS=60
ENTITLEMENT_EXPIRY_INTERVAL_SECONDS=300
WEBHOOK_CHECK_INTERVAL_SECONDS=600

# Webhook protection
WEBHOOK_MAX_BODY_BYTES=65536
WEBHOOK_RATE_LIMIT_PER_MINUTE=1200
TRUST_PROXY=0

LOG_LEVEL=INFO
METRICS_ENABLED=1
CORS_ORIGINS=
